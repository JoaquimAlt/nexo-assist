{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"]
  },
  "include": ["server", "src/agent/engine.ts", "src/data", "src/lib/sla.ts", "src/lib/time.ts", "src/lib/id.ts", "src/lib/limits.ts", "src/store/selectors.ts"],
  "exclude": ["**/*.test.ts"]
}
