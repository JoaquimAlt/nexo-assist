# Modelo que interpreta as mensagens, no formato provedor/modelo.
#   google/gemini-3.8-flash → Gemini (padrão; requer GOOGLE_API_KEY)
#   ollama/qwen2.5:3b       → local e offline, requer o Ollama (https://ollama.com); lento sem GPU
#   off                     → sem modelo: o agent usa só as regras
NEXO_MODEL=google/gemini-3.8-flash

# Chave do Gemini: https://aistudio.google.com/apikey (nível gratuito: não configure faturamento)
GOOGLE_API_KEY=

# Tempo máximo de espera pelo modelo antes de cair nas regras (ms). Para o Ollama em CPU, use 45000.
LLM_TIMEOUT_MS=10000

# Teto de chamadas ao modelo por dia (contém custo e abuso)
LLM_DAILY_LIMIT=200

# Endereço do Ollama (só se NEXO_MODEL for ollama/...)
OLLAMA_URL=http://localhost:11434

# Banco: sem as variáveis abaixo, usa o arquivo NEXO_DB_FILE (desenvolvimento local).
# No deploy na Vercel, conecte um Upstash Redis ao projeto (Storage) e ele cria KV_REST_API_URL e KV_REST_API_TOKEN.
NEXO_DB_FILE=server/data/db.json
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Chance de falha do sistema de chamados simulado (0 a 1). Use 0.5 para ver as novas tentativas.
LEGACY_FAILURE_RATE=0.08

# Porta da API local
PORT=8787
