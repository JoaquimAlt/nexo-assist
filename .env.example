# Modelo que interpreta as mensagens, no formato provedor/modelo.
#   ollama/qwen2.5:3b       → local, gratuito e offline (padrão). Requer o Ollama: https://ollama.com
#   google/gemini-3.8-flash → Gemini (requer GOOGLE_API_KEY)
#   off                     → sem modelo: o agent usa só as regras
NEXO_MODEL=ollama/qwen2.5:3b

# Endereço do Ollama
OLLAMA_URL=http://localhost:11434

# Só se NEXO_MODEL for google/...: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Tempo máximo de espera pelo modelo antes de cair nas regras (ms). Modelo local em CPU é mais lento.
LLM_TIMEOUT_MS=45000

# Teto de chamadas ao modelo por dia
LLM_DAILY_LIMIT=500

# Chance de falha do sistema de chamados simulado (0 a 1). Use 0.5 para ver as novas tentativas.
LEGACY_FAILURE_RATE=0.08

# Porta da API
PORT=8787

# Arquivo do banco (JSON)
NEXO_DB_FILE=server/data/db.json
